# Copie este arquivo para .env e ajuste conforme o seu ambiente.
#
# ATENCAO: toda variavel com o prefixo NEXT_PUBLIC_ e embutida no bundle
# enviado ao navegador. Nunca coloque segredo em variavel NEXT_PUBLIC_.

# API
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Aplicacao
NEXT_PUBLIC_APP_NAME=SARA
NEXT_PUBLIC_APP_DESCRIPTION="Sistema de Avaliacao e Revisao de Artigos"

# Object storage (MinIO ou S3) que serve imagens e PDFs.
# Informe apenas o host, sem protocolo e sem barra final.
# Deixe vazio se servir os arquivos apenas pela API local.
NEXT_PUBLIC_STORAGE_HOST=

# Upload
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
NEXT_PUBLIC_ALLOWED_PDF_TYPES=application/pdf

# Funcionalidades
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_PWA=true

# Ambiente
NODE_ENV=development

# Analytics (opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=XXXXXXX
